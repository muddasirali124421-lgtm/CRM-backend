# Application Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/officecrm?schema=public

# Authentication / JWT Secrets & Expiry
# JWT Secrets must be cryptographically secure random strings (minimum 32 characters in production)
JWT_ACCESS_SECRET=officecrm_dev_jwt_access_secret_change_in_production_32chars
JWT_REFRESH_SECRET=officecrm_dev_jwt_refresh_secret_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (CRM Frontend)
FRONTEND_URL=http://localhost:5173

# File Storage Configuration
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=storage/uploads
MAX_UPLOAD_SIZE_MB=25
